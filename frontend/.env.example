# ====================================================
# VARIÁVEIS DE AMBIENTE - Frontend Sistema Clínico Youx
# ====================================================
# Copie este arquivo para .env e configure as variáveis

# API Configuration
VITE_API_URL=http://localhost:8080/api

# Application Configuration  
VITE_APP_NAME=Sistema Clínico Youx
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Debug Configuration
VITE_DEBUG=true
VITE_API_DEBUG=true

# JWT Configuration
VITE_JWT_EXPIRATION_TIME=3600000
VITE_JWT_STORAGE_KEY=clinica_token

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_DEFAULT_LOCALE=pt-BR

# Feature Flags
VITE_ENABLE_EXPERIMENTAL_FEATURES=false
VITE_ENABLE_DEV_MODE=true
